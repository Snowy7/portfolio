---
// Stylized Blender shader-editor view: procedural lava material.
// Noise Texture splits into two paths — one through ColorRamp → Emission,
// one through Bump → Normal — both feeding Material Output.
---

<figure class="my-8 not-prose">
  <div class="bg-[#0a0a0a] border border-[#1a1a1a] rounded-xl p-4 sm:p-6 overflow-x-auto">
    <svg
      viewBox="0 0 760 320"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto min-w-[680px]"
      role="img"
      aria-label="Blender shader nodes: Noise Texture, ColorRamp, Bump, Emission, Material Output"
    >
      <defs>
        <!-- Blender uses color-coded node headers per category. We mirror that:
             texture = red-ish, converter = blue-ish, shader = green-ish, output = orange-ish. -->
        <linearGradient id="blHeaderTex" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="rgba(220, 80, 80, 0.32)" />
          <stop offset="1" stop-color="rgba(220, 80, 80, 0.18)" />
        </linearGradient>
        <linearGradient id="blHeaderConv" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="rgba(96, 165, 250, 0.32)" />
          <stop offset="1" stop-color="rgba(96, 165, 250, 0.18)" />
        </linearGradient>
        <linearGradient id="blHeaderShader" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="rgba(34, 197, 94, 0.32)" />
          <stop offset="1" stop-color="rgba(34, 197, 94, 0.18)" />
        </linearGradient>
        <linearGradient id="blHeaderOut" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="rgba(251, 191, 36, 0.32)" />
          <stop offset="1" stop-color="rgba(251, 191, 36, 0.18)" />
        </linearGradient>
        <!-- Grid pattern for the canvas background, evoking Blender's node editor -->
        <pattern id="blGrid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#111" stroke-width="0.5"/>
        </pattern>
      </defs>

      <!-- Faint grid background like the Blender shader editor -->
      <rect x="0" y="0" width="760" height="320" fill="url(#blGrid)" opacity="0.6"/>

      <!-- Connections (drawn first so they sit behind nodes).
           Blender uses smooth curved noodles in different colors per socket type. -->
      <g fill="none" stroke-width="1.5">
        <!-- Noise.Fac → ColorRamp.Fac  (grey, "value" socket) -->
        <path d="M 175 130 C 215 130, 215 105, 255 105" stroke="rgba(180, 180, 180, 0.6)"/>
        <!-- Noise.Fac → Bump.Height -->
        <path d="M 175 130 C 215 130, 215 240, 255 240" stroke="rgba(180, 180, 180, 0.6)"/>
        <!-- ColorRamp.Color → Emission.Color  (yellow, "color" socket) -->
        <path d="M 395 105 C 435 105, 435 110, 475 110" stroke="rgba(251, 191, 36, 0.6)"/>
        <!-- Emission.BSDF → Material Output.Surface  (green, "shader" socket) -->
        <path d="M 615 115 C 645 115, 645 110, 670 110" stroke="rgba(34, 197, 94, 0.7)"/>
        <!-- Bump.Normal → Emission (no Normal slot on Emission, route to Material Output Displacement instead) -->
        <path d="M 395 240 C 535 240, 535 145, 670 145" stroke="rgba(96, 165, 250, 0.6)"/>
      </g>

      <!-- ───────── Noise Texture (texture node, red header) ───────── -->
      <g>
        <rect x="35" y="80" width="140" height="100" rx="6" fill="#161616" stroke="#2a2a2a" stroke-width="1"/>
        <rect x="35" y="80" width="140" height="18" rx="6" fill="url(#blHeaderTex)"/>
        <rect x="35" y="92" width="140" height="6" fill="url(#blHeaderTex)"/>
        <text x="105" y="92" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="9" fill="#eee" font-weight="600">Noise Texture</text>

        <!-- output socket row: Fac -->
        <circle cx="175" cy="112" r="3.5" fill="#cccccc" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="165" y="115" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#999">Fac</text>
        <!-- output socket row: Color -->
        <circle cx="175" cy="130" r="3.5" fill="#fbbf24" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="165" y="133" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#999">Color</text>

        <!-- Property: Scale -->
        <text x="45" y="152" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#666">Scale</text>
        <text x="165" y="152" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#22c55e">12.0</text>
        <!-- Property: Detail -->
        <text x="45" y="166" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#666">Detail</text>
        <text x="165" y="166" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#22c55e">10.0</text>
      </g>

      <!-- ───────── ColorRamp (converter, blue header) ───────── -->
      <g>
        <rect x="255" y="80" width="140" height="60" rx="6" fill="#161616" stroke="#2a2a2a" stroke-width="1"/>
        <rect x="255" y="80" width="140" height="18" rx="6" fill="url(#blHeaderConv)"/>
        <rect x="255" y="92" width="140" height="6" fill="url(#blHeaderConv)"/>
        <text x="325" y="92" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="9" fill="#eee" font-weight="600">ColorRamp</text>

        <!-- input + output sockets -->
        <circle cx="255" cy="105" r="3.5" fill="#cccccc" stroke="#0a0a0a" stroke-width="1.2"/>
        <circle cx="395" cy="105" r="3.5" fill="#fbbf24" stroke="#0a0a0a" stroke-width="1.2"/>

        <!-- Ramp gradient bar -->
        <defs>
          <linearGradient id="ramp" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#000000"/>
            <stop offset="0.4" stop-color="#7c1d0e"/>
            <stop offset="0.7" stop-color="#f97316"/>
            <stop offset="1" stop-color="#fde047"/>
          </linearGradient>
        </defs>
        <rect x="265" y="118" width="120" height="14" rx="2" fill="url(#ramp)" stroke="#0a0a0a" stroke-width="0.5"/>
      </g>

      <!-- ───────── Bump (vector, blue header) ───────── -->
      <g>
        <rect x="255" y="210" width="140" height="56" rx="6" fill="#161616" stroke="#2a2a2a" stroke-width="1"/>
        <rect x="255" y="210" width="140" height="18" rx="6" fill="url(#blHeaderConv)"/>
        <rect x="255" y="222" width="140" height="6" fill="url(#blHeaderConv)"/>
        <text x="325" y="222" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="9" fill="#eee" font-weight="600">Bump</text>

        <circle cx="255" cy="240" r="3.5" fill="#cccccc" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="265" y="243" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#999">Height</text>
        <circle cx="395" cy="240" r="3.5" fill="#60a5fa" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="385" y="243" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#999">Normal</text>

        <text x="265" y="258" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#666">Strength</text>
        <text x="385" y="258" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#22c55e">0.4</text>
      </g>

      <!-- ───────── Emission (shader, green header) ───────── -->
      <g>
        <rect x="475" y="85" width="140" height="60" rx="6" fill="#161616" stroke="#2a2a2a" stroke-width="1"/>
        <rect x="475" y="85" width="140" height="18" rx="6" fill="url(#blHeaderShader)"/>
        <rect x="475" y="97" width="140" height="6" fill="url(#blHeaderShader)"/>
        <text x="545" y="97" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="9" fill="#eee" font-weight="600">Emission</text>

        <circle cx="475" cy="110" r="3.5" fill="#fbbf24" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="485" y="113" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#999">Color</text>
        <circle cx="615" cy="115" r="3.5" fill="#22c55e" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="605" y="118" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#999">BSDF</text>

        <text x="485" y="132" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#666">Strength</text>
        <text x="605" y="132" text-anchor="end" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#22c55e">3.0</text>
      </g>

      <!-- ───────── Material Output (output, orange header) ───────── -->
      <g>
        <rect x="670" y="80" width="80" height="80" rx="6" fill="#161616" stroke="#2a2a2a" stroke-width="1.2"/>
        <rect x="670" y="80" width="80" height="18" rx="6" fill="url(#blHeaderOut)"/>
        <rect x="670" y="92" width="80" height="6" fill="url(#blHeaderOut)"/>
        <text x="710" y="92" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#eee" font-weight="600">Output</text>

        <circle cx="670" cy="110" r="3.5" fill="#22c55e" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="680" y="113" font-family="'IBM Plex Mono', monospace" font-size="7" fill="#999">Surface</text>
        <circle cx="670" cy="125" r="3.5" fill="#22c55e" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="680" y="128" font-family="'IBM Plex Mono', monospace" font-size="7" fill="#999">Volume</text>
        <circle cx="670" cy="145" r="3.5" fill="#60a5fa" stroke="#0a0a0a" stroke-width="1.2"/>
        <text x="680" y="148" font-family="'IBM Plex Mono', monospace" font-size="7" fill="#999">Displ.</text>
      </g>

      <!-- Legend -->
      <g font-family="'IBM Plex Mono', monospace" font-size="8" fill="#666">
        <text x="35" y="40" letter-spacing="0.15em" fill="#444">NODE CATEGORIES</text>
        <circle cx="40" cy="55" r="3.5" fill="rgba(220, 80, 80, 0.6)"/>
        <text x="50" y="58">Texture</text>
        <circle cx="110" cy="55" r="3.5" fill="rgba(96, 165, 250, 0.6)"/>
        <text x="120" y="58">Vector</text>
        <circle cx="175" cy="55" r="3.5" fill="rgba(34, 197, 94, 0.6)"/>
        <text x="185" y="58">Shader</text>
        <circle cx="240" cy="55" r="3.5" fill="rgba(251, 191, 36, 0.6)"/>
        <text x="250" y="58">Output</text>
      </g>

      <text x="395" y="300" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="8" fill="#444" letter-spacing="0.15em">
        NOISE TEXTURE → COLORRAMP → EMISSION → MATERIAL OUTPUT
      </text>
    </svg>
  </div>
  <figcaption class="text-[10px] text-[#555] font-plex tracking-wider uppercase text-center mt-2">
    fig 4 — blender shader nodes: procedural lava material
  </figcaption>
</figure>
