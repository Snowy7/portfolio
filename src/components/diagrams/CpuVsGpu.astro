---
// Side-by-side illustration of CPU (few large cores) vs GPU (many tiny cores).
// The point of the visual is the *density* — same physical chip, drastically
// different parallelism.
---

<figure class="my-8 not-prose">
  <div class="bg-[#0a0a0a] border border-[#1a1a1a] rounded-xl p-4 sm:p-6">
    <div class="grid grid-cols-2 gap-4 sm:gap-8">
      <!-- ─── CPU ─── -->
      <div class="flex flex-col items-center">
        <div class="text-[9px] tracking-[0.2em] uppercase text-[#666] font-plex mb-3">CPU</div>
        <svg viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[180px]" role="img" aria-label="CPU with 4 large cores">
          <!-- Chip outline -->
          <rect x="20" y="20" width="120" height="120" rx="6" fill="#0f0f0f" stroke="#2a2a2a" stroke-width="1.5" />
          <!-- Pins -->
          {Array.from({ length: 6 }).map((_, i) => (
            <Fragment>
              <rect x={28 + i * 18} y="14" width="6" height="6" fill="#2a2a2a" />
              <rect x={28 + i * 18} y="140" width="6" height="6" fill="#2a2a2a" />
              <rect x="14" y={28 + i * 18} width="6" height="6" fill="#2a2a2a" />
              <rect x="140" y={28 + i * 18} width="6" height="6" fill="#2a2a2a" />
            </Fragment>
          ))}
          <!-- 4 cores (2x2 grid, large) -->
          {[0, 1].map((row) => (
            [0, 1].map((col) => (
              <g>
                <rect
                  x={36 + col * 50}
                  y={36 + row * 50}
                  width="40"
                  height="40"
                  rx="3"
                  fill="rgba(34, 197, 94, 0.12)"
                  stroke="#22c55e"
                  stroke-width="1"
                />
                <text
                  x={56 + col * 50}
                  y={61 + row * 50}
                  text-anchor="middle"
                  font-family="'IBM Plex Mono', monospace"
                  font-size="8"
                  fill="#22c55e"
                  opacity="0.7"
                >core</text>
              </g>
            ))
          )).flat()}
        </svg>
        <div class="mt-4 space-y-1 text-center">
          <div class="text-[11px] font-plex text-[#888]"><span class="text-green-400">4</span> cores</div>
          <div class="text-[10px] font-plex text-[#555]">few · fast · sequential</div>
        </div>
      </div>

      <!-- ─── GPU ─── -->
      <div class="flex flex-col items-center">
        <div class="text-[9px] tracking-[0.2em] uppercase text-[#666] font-plex mb-3">GPU</div>
        <svg viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[180px]" role="img" aria-label="GPU with many small cores in a grid">
          <!-- Chip outline -->
          <rect x="20" y="20" width="120" height="120" rx="6" fill="#0f0f0f" stroke="#2a2a2a" stroke-width="1.5" />
          <!-- Pins -->
          {Array.from({ length: 6 }).map((_, i) => (
            <Fragment>
              <rect x={28 + i * 18} y="14" width="6" height="6" fill="#2a2a2a" />
              <rect x={28 + i * 18} y="140" width="6" height="6" fill="#2a2a2a" />
              <rect x="14" y={28 + i * 18} width="6" height="6" fill="#2a2a2a" />
              <rect x="140" y={28 + i * 18} width="6" height="6" fill="#2a2a2a" />
            </Fragment>
          ))}
          <!-- Many tiny cores (10x10) -->
          {Array.from({ length: 10 }).map((_, row) => (
            Array.from({ length: 10 }).map((_, col) => {
              // Vary opacity so it looks "alive"
              const seed = (row * 7 + col * 13) % 9;
              const op = 0.35 + (seed / 18);
              return (
                <rect
                  x={30 + col * 10}
                  y={30 + row * 10}
                  width="8"
                  height="8"
                  rx="1"
                  fill="rgba(34, 197, 94, 0.5)"
                  opacity={op}
                />
              );
            })
          )).flat()}
        </svg>
        <div class="mt-4 space-y-1 text-center">
          <div class="text-[11px] font-plex text-[#888]"><span class="text-green-400">2,000+</span> cores</div>
          <div class="text-[10px] font-plex text-[#555]">many · tiny · parallel</div>
        </div>
      </div>
    </div>

    <!-- Comparison row -->
    <div class="grid grid-cols-2 gap-4 sm:gap-8 mt-6 pt-5 border-t border-[#1a1a1a]">
      <ul class="space-y-1.5 text-[11px] font-plex text-[#888]">
        <li class="flex gap-2"><span class="text-green-400/40 shrink-0">→</span> Branching, if/else, decisions</li>
        <li class="flex gap-2"><span class="text-green-400/40 shrink-0">→</span> Reads files, talks to network</li>
        <li class="flex gap-2"><span class="text-green-400/40 shrink-0">→</span> Runs gameplay logic, AI</li>
      </ul>
      <ul class="space-y-1.5 text-[11px] font-plex text-[#888]">
        <li class="flex gap-2"><span class="text-green-400/40 shrink-0">→</span> Same math on millions of items</li>
        <li class="flex gap-2"><span class="text-green-400/40 shrink-0">→</span> No branching, just compute</li>
        <li class="flex gap-2"><span class="text-green-400/40 shrink-0">→</span> Runs once per vertex / pixel</li>
      </ul>
    </div>
  </div>
  <figcaption class="text-[10px] text-[#555] font-plex tracking-wider uppercase text-center mt-2">
    fig 2 — cpu vs gpu architecture
  </figcaption>
</figure>
