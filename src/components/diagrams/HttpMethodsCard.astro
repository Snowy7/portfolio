---
// Visual reference for the four common HTTP methods. Each one gets a
// color-coded chip (Postman-style) and a one-line plain-English purpose.
const methods = [
  { name: "GET",    chip: "green",  purpose: "Retrieve data",        example: "/users/42",   safe: true,  idempotent: true  },
  { name: "POST",   chip: "orange", purpose: "Create / send new",    example: "/users",      safe: false, idempotent: false },
  { name: "PUT",    chip: "blue",   purpose: "Replace / update",     example: "/users/42",   safe: false, idempotent: true  },
  { name: "DELETE", chip: "red",    purpose: "Remove data",          example: "/users/42",   safe: false, idempotent: true  },
];

// Map chip name → Tailwind classes so we don't repeat the same combinations
const chipClasses: Record<string, string> = {
  green:  "bg-green-400/15 text-green-400 border-green-400/30",
  orange: "bg-orange-400/15 text-orange-400 border-orange-400/30",
  blue:   "bg-blue-400/15 text-blue-400 border-blue-400/30",
  red:    "bg-red-400/15 text-red-400 border-red-400/30",
};
---

<figure class="my-8 not-prose">
  <div class="bg-[#0a0a0a] border border-[#1a1a1a] rounded-xl p-4 sm:p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {methods.map((m) => (
        <div class="bg-[#0f0f0f] border border-[#1a1a1a] rounded-lg p-3 hover:border-[#2a2a2a] transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class={`px-2.5 py-1 rounded text-[10px] font-plex font-semibold tracking-wider border ${chipClasses[m.chip]}`}>
              {m.name}
            </span>
            <code class="text-[10px] font-plex text-[#666] truncate">{m.example}</code>
          </div>
          <p class="text-[12px] text-[#bbb] font-plex mb-2">{m.purpose}</p>
          <div class="flex gap-2 text-[9px] tracking-wider uppercase font-plex">
            <span class={m.safe ? "text-green-400/70" : "text-[#444]"}>
              {m.safe ? "✓ safe" : "✗ not safe"}
            </span>
            <span class="text-[#333]">·</span>
            <span class={m.idempotent ? "text-green-400/70" : "text-[#444]"}>
              {m.idempotent ? "✓ idempotent" : "✗ not idempotent"}
            </span>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-4 pt-3 border-t border-[#1a1a1a] flex flex-wrap gap-x-6 gap-y-1 text-[10px] font-plex text-[#666]">
      <span><span class="text-green-400/70">safe</span> — doesn't change server state</span>
      <span><span class="text-green-400/70">idempotent</span> — calling twice = calling once</span>
    </div>
  </div>
  <figcaption class="text-[10px] text-[#555] font-plex tracking-wider uppercase text-center mt-2">
    fig 3 — common http methods
  </figcaption>
</figure>
